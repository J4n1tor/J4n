#!/usr/bin/env bash
# t <cargo args…> — one cargo command with an empty HOME, no agent CLIs on PATH, a dead proxy and a memory cap.
# A run that writes into HOME fails (docs/TESTING.md). Runs from the repository root, so
# paths in the arguments are relative to it, and the exit status is cargo's unless HOME was written (then 1) or no
# run directory could be made (then 2).
# In:  J4N_T_ROOT  the directory the run directory is made in (default $HOME/.cache; not /tmp, which is often a small tmpfs)
#      J4N_BLESS   passed on to the run when set
#      CARGO_INCREMENTAL  passed on; 0 (no incremental cache) when unset
#      J4N_SWEEP   passed on to the run when set: the folder the screen sweep writes its pages in (with J4N_SWEEP_ONLY)
#      J4N_T_JOBS  how many jobs cargo builds with (default 2)
#      J4N_T_SLOTS how many runs of this script may build at once on this machine (default 1 under 12 GB of memory, else 2);
#                  a run waits for a free slot, so parallel sessions cannot push the machine into swap together
# Out: J4N_CAP     "on" when the run is under the 5G memory cap, "off" when no systemd user manager is there
#      J4N_HERMETIC  1, so a test can tell that it runs under this script
#      TZ           UTC, so the time of day on a turn (otherwise the machine's zone) is the same on every machine and the goldens keep their ##:##
set -uo pipefail
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 2
REAL_HOME="$HOME"
T_ROOT="${J4N_T_ROOT:-$REAL_HOME/.cache}"
mkdir -p "$T_ROOT" && RUN="$(mktemp -d "$T_ROOT/j4n-t.XXXXXX")" || {
  echo "t: cannot create a run directory in $T_ROOT" >&2
  exit 2
}
trap 'chmod -R u+rwX "$RUN" 2>/dev/null; rm -rf "$RUN"' EXIT   # a test may leave a read-only directory in TMPDIR
REAL_CARGO_HOME="${CARGO_HOME:-$REAL_HOME/.cargo}"
mkdir -p "$RUN/home" "$RUN/tmp" "$RUN/bin" "$RUN/cargo/bin"
# rustup puts $CARGO_HOME/bin on the PATH of every tool it starts, and that directory can hold an agent CLI:
# the run gets a CARGO_HOME that is the real one (registry, git, config, locks) with an empty bin.
mirror=()
shopt -s nullglob dotglob
for f in "$REAL_CARGO_HOME"/*; do
  [ "${f##*/}" = bin ] || mirror+=("$f")
done
shopt -u nullglob dotglob
# `ln <files…> <dir>`, not `ln -t`, which BSD's ln (macOS) does not have
[ "${#mirror[@]}" -gt 0 ] && ln -s "${mirror[@]}" "$RUN/cargo"
# One `ln` per directory: a link per file costs a fork each (about 6 s for the 4,000 tools of /usr/bin).
for d in /usr/local/bin /usr/bin /bin "$REAL_CARGO_HOME/bin"; do
  [ -d "$d" ] || continue
  tools=()
  for f in "$d"/*; do
    case "${f##*/}" in claude|omp|codex|opencode|pi|gemini|msb|j4n) continue ;; esac
    [ -f "$f" ] && [ -x "$f" ] && tools+=("$f")
  done
  [ "${#tools[@]}" -gt 0 ] && ln -sf "${tools[@]}" "$RUN/bin" 2>/dev/null
done
CAP=()
capped=off
if command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope -q true >/dev/null 2>&1; then
  # MemorySwapMax: a run that outgrows memory is stopped inside its own scope rather than filling swap, where the
  # desktop's OOM daemon would end whatever holds the most swap (often the terminal the run was started from)
  CAP=(systemd-run --user --scope -q -p MemoryMax=5G -p MemorySwapMax=1G)
  capped=on
else
  echo "t: no systemd user manager, running without the 5G cap" >&2
fi
ENVV=(
  HOME="$RUN/home" PATH="$RUN/bin" TMPDIR="$RUN/tmp" J4N_HERMETIC=1 J4N_CAP="$capped" TZ=UTC
  CARGO_HOME="$RUN/cargo" RUSTUP_HOME="${RUSTUP_HOME:-$REAL_HOME/.rustup}"
  CARGO_BUILD_JOBS="${J4N_T_JOBS:-2}" CARGO_PROFILE_DEV_DEBUG=0
  # off unless the caller asks: the incremental cache grows by gigabytes per build
  CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
  CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
  http_proxy=http://127.0.0.1:9 https_proxy=http://127.0.0.1:9 all_proxy=http://127.0.0.1:9
  HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9 ALL_PROXY=http://127.0.0.1:9
  HISTFILE=/dev/null LANG="${LANG:-C.UTF-8}" TERM="${TERM:-xterm-256color}" USER="${USER:-j4n}" LOGNAME="${USER:-j4n}"
)
[ -n "${J4N_BLESS:-}" ] && ENVV+=(J4N_BLESS="$J4N_BLESS")
[ -n "${J4N_SWEEP:-}" ] && ENVV+=(J4N_SWEEP="$J4N_SWEEP" J4N_SWEEP_ONLY="${J4N_SWEEP_ONLY:-}")   # the sweep writes its pages there (tests/laws/sweep.rs)
# an empty array spelled so that a bash older than 4.4 (macOS's own) does not take it for an unset one
# One slot per build on this machine (Linux flock; elsewhere no wait). The lock is held on fd 9 by this shell only:
# cargo and what it starts get the fd closed, so a process left behind cannot keep a slot.
if command -v flock >/dev/null 2>&1; then
  SLOT_DIR="$REAL_HOME/.cache"   # one place per machine, whatever J4N_T_ROOT a run uses
  mkdir -p "$SLOT_DIR"
  mem_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  slots=${J4N_T_SLOTS:-$([ "${mem_kb:-0}" -lt 12000000 ] && echo 1 || echo 2)}
  waited=no
  while :; do
    got=no
    for i in $(seq 1 "$slots"); do
      exec 9>"$SLOT_DIR/j4n-t.slot.$i"
      if flock -n 9; then got=yes; break; fi
      exec 9>&-
    done
    [ "$got" = yes ] && break
    [ "$waited" = no ] && echo "t: waiting for a build slot ($slots on this machine; J4N_T_SLOTS changes it)" >&2
    waited=yes
    sleep 3
  done
fi
${CAP[@]+"${CAP[@]}"} env -i "${ENVV[@]}" cargo "$@" 9>&-
rc=$?
h=$(find "$RUN/home" -mindepth 1 | wc -l)
if [ "$h" -ne 0 ]; then
  echo "t: WROTE $h entries into HOME" >&2
  find "$RUN/home" -mindepth 1 | sed "s|$RUN/home|HOME|" | head -20 >&2
  rc=1
fi
exit $rc
